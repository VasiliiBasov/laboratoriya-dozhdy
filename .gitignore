# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Тяжёлые исходники видео (4K HEVC, .SRT) не тащим в git — они не нужны на runner,
# билд локально берёт уже транскодированный bgVideo.mp4.
# При этом сам bgVideo.mp4 (≈13.5 MB H.264 1080p) коммитим — он нужен сборке.
/src/assets/videos/*.MP4
/src/assets/videos/*.SRT
/src/assets/videos/Пролет*
!/src/assets/videos/
!/src/assets/videos/bgVideo.mp4

# Beget audit / артефакты деплоя
/_beget_audit*
/_beget_audit_xlsx/
/_beget_full/
/_beget_lite/
/_extract.ps1
/build.log
/laboratoriya-dozhdy-deploy.zip
/thegreenstone-beget-deploy*.zip
/build/
/winscp.ini
# WinSCP-скрипты деплоя содержат пароль в URL, не коммитим
/upload.txt
/post-upload.txt
/winscp-upload.log
/winscp-post.log
/_build.log
/_winscp*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SSH-debug screenshots from earlier sessions (transient, not shipped)
src/assets/images/ssh_debug_*.png
src/assets/images/latest_ssh_debug.png

# Скриншоты из IDE/терминала могут содержать токены/пароли в выводе, не коммитим
Снимок*
/_backup/
Screenshot*
Screen*

# Временные блобы / кеш IDE и редакторов
.tmp_blobs/
*.tmp
*.swp
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

