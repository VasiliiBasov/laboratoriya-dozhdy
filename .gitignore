# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
# /build — это артефакт сборки. Его НЕ коммитим: его собирает CI
# (.github/workflows/deploy.yml) на каждый push в main и сам заливает
# на Beget по SSH через rsync. Поэтому ни сборка, ни 3D-модели
# (build/models/*.glb), ни видео в репо не нужны.
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Тяжёлые исходники видео не тащим в git:
#   • 4K HEVC и .SRT — не нужны на runner,
#   • bgVideo.mp4 (~224 МБ H.264 1080p «Пролёт 4 Сосны») — не коммитим
#     и не пытаемся собирать без него: CI собирает проект, а сам файл
#     видео на сервере хранится отдельно (rsync его не трогает).
#   • bgVideoProlet.mp4 — то же видео, переименованное. Лежит ТОЛЬКО
#     в /home/l/lizaptsw/rain-lab.ru/public_html/static/media/ на Beget,
#     заливается туда ВРУЧНУЮ через WinSCP. В репо его быть не должно —
#     GitHub отклоняет такие файлы, и CI всё равно его не потащит
#     (build/ его не включает, rsync --delete не используется).
/src/assets/videos/*.MP4
/src/assets/videos/*.SRT
/src/assets/videos/Пролет*
/src/assets/videos/bgVideo.mp4
/src/assets/videos/bgVideoProlet.mp4
/src/assets/videos/bgVideoProlet.MP4
!/src/assets/videos/

# Beget audit / артефакты деплоя
/_beget_audit*
/_beget_audit_xlsx/
/_beget_full/
/_beget_lite/
/_extract.ps1
/build.log
/laboratoriya-dozhdy-deploy.zip
/thegreenstone-beget-deploy*.zip
/winscp.ini
# WinSCP-скрипты деплоя содержат пароль в URL, не коммитим
/upload.txt
/post-upload.txt
/winscp-upload.log
/winscp-post.log
/_build.log
/_winscp*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SSH-debug screenshots from earlier sessions (transient, not shipped)
src/assets/images/ssh_debug_*.png
src/assets/images/latest_ssh_debug.png

# Скриншоты из IDE/терминала могут содержать токены/пароли в выводе, не коммитим
Снимок*
/_backup/
Screenshot*
Screen*

# Временные блобы / кеш IDE и редакторов
.tmp_blobs/
*.tmp
*.swp
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

